# ============================================================
# RRHH Bolivia MVP — Plantilla de variables de entorno
# Copiar como .env y ajustar los valores. El .env real NUNCA sube a Git.
# ============================================================

# Database (CAMBIAR con tus credenciales)
DATABASE_URL=postgresql://postgres:TU_PASSWORD@localhost:5432/rrhh_bolivia_db

# Schema de PostgreSQL
DB_SCHEMA=rrhh

# App
APP_NAME="Sistema RRHH Bolivia"
APP_VERSION=0.1.0
API_PREFIX=/api/v1

# DEBUG=True imprime cada query SQL en la consola. Solo en desarrollo.
DEBUG=True

# Carpetas de archivos (no suben a Git)
UPLOAD_DIR=uploads
REPORTS_DIR=reportes_generados

# ── Seguridad / JWT ───────────────────────────────────────────
# EN USO: con estas tres variables se firman y validan los access tokens que
# emite POST /api/v1/auth/login (ver app/core/security.py).
#
# SECRET_KEY es la clave de firma HMAC. Quien la tenga puede fabricar tokens
# válidos para cualquier usuario, así que en Railway hay que generar una propia
# y NO reutilizar la de desarrollo:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Cambiarla invalida todos los tokens ya emitidos (los usuarios deben re-loguear).
SECRET_KEY=cambiar-esta-clave-secreta-en-produccion-usar-algo-muy-largo-y-aleatorio

# Algoritmo de firma. HS256 (clave simétrica) es lo correcto acá: la API es la
# única que firma y verifica.
ALGORITHM=HS256

# Vigencia del access token en minutos. No hay refresh token todavía: al vencer,
# el usuario vuelve a loguearse.
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── CORS ──────────────────────────────────────────────────────
# Orígenes del navegador autorizados a llamar a la API, separados por comas.
# Escribirlos con esquema (http:// o https://) y SIN barra final.
#
# El default en el código es vacío: si esta variable no está definida, la API
# rechaza todas las peticiones cross-origin. Eso es deliberado — cada entorno
# declara los suyos y un despliegue sin configurar nunca queda abierto.
#
# Desarrollo (Vite corre en 5173):
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
#
# PRODUCCIÓN (Railway): reemplazar los valores de arriba por el dominio real
# del frontend desplegado, por ejemplo:
#   ALLOWED_ORIGINS=https://asistencia.bluenet.com.bo
# Si el frontend vive en varios dominios (dominio propio + subdominio de
# Railway), listarlos todos separados por comas:
#   ALLOWED_ORIGINS=https://asistencia.bluenet.com.bo,https://bluenet-asistencia.up.railway.app
# NO dejar los localhost en producción.
